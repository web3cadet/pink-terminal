# Telegram. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# Polyester testnet API key. The secret is the 32-byte Ed25519 seed as hex.
POLYESTER_API_URL=https://api.testnet.polyester.com
POLYESTER_API_KEY_ID=
POLYESTER_API_SECRET_HEX=
POLYESTER_SUBACCOUNT_ID=

# Modes: paper = simulated funds; read_only = real account reads with all writes blocked; live = signed writes.
TRADING_MODE=read_only
CONFIRMATION_TTL_SECONDS=90

# Local state and polling.
DATABASE_PATH=./data/polyester-bot.sqlite
POLL_INTERVAL_MS=15000
LOG_LEVEL=info
